<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevelSecurity>latest-all</AnalysisLevelSecurity>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PlayerPunishments</AssemblyName>
    <RootNamespace>PlayerPunishments</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.2</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <InternalsVisibleTo Include="PlayerPunishments.RegressionTests" />
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.372" />
  </ItemGroup>
</Project>